{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api?sti=$1"
    }
  ],
  "redirects": [
    {
      "source": "/OmOs.html",
      "destination": "/om-os/",
      "permanent": true
    },
    {
      "source": "/billed-galleri.html",
      "destination": "/galleri/",
      "permanent": true
    },
    {
      "source": "/news & events.html",
      "destination": "/arrangementskalender/",
      "permanent": true
    },
    {
      "source": "/admiralsforsamlingen-2020.html",
      "destination": "/om-os/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/dokumenter/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "functions": {
    "api/index.js": {
      "includeFiles": "api/_{skema.sql,slopkisten.json}"
    }
  }
}